# design-sync — staged converter scripts + its own isolated node_modules
# (esbuild binary, ts-morph, etc.), regenerated build output, and machine-
# local cache/verification state. .design-sync/config.json, NOTES.md,
# conventions.md, previews/, and overrides/ are NOT ignored — those are the
# durable, human-authored parts meant to be committed.
/.ds-sync/
/ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
