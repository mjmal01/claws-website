{
  "name": "claws-website",
  "version": "0.1.0",
  "private": true,
  "types": ".design-sync/dist/.design-sync/entry.d.ts",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "design-sync:prep": "tsc -p .design-sync/tsconfig.declarations.json && tsc-alias -p .design-sync/tsconfig.declarations.json && tailwindcss -i app/globals.css -o .design-sync/dist/tailwind.css -c tailwind.config.ts && cat .design-sync/fonts.css >> .design-sync/dist/tailwind.css",
    "design-sync:build": "npm run design-sync:prep && node .ds-sync/package-build.mjs --config .design-sync/config.json --node-modules ./node_modules --entry .design-sync/entry.tsx --out ./ds-bundle",
    "design-sync:validate": "node .ds-sync/package-validate.mjs ./ds-bundle",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@slack/web-api": "^7.15.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "@types/qrcode": "^1.5.6",
    "framer-motion": "^12.36.0",
    "googleapis": "^171.4.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^4.15.9",
    "next": "16.2.12",
    "next-auth": "^4.24.13",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsc-alias": "^1.9.1",
    "typescript": "^5",
    "storybook": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-mcp": "^0.7.0",
    "vite": "^8.2.0",
    "eslint-plugin-storybook": "^10.5.5",
    "vitest": "^4.1.10",
    "playwright": "^1.62.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10"
  }
}
